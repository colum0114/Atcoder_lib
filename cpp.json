    "Combination_nCr": {
        "prefix": "myncr",
        "body": [
            "// 巨大な累乗 A^B % P を O(log B) で高速に求める関数",
            "ll mypow(ll a, ll b, ll p) {",
            "    if (p == 1) return 0;",
            "    ll ans = 1;",
            "    a %= p;",
            "    while (b > 0) {",
            "        if (b % 2 == 1) ans = (ans * a) % p;",
            "        a = (a * a) % p;",
            "        b /= 2;",
            "    }",
            "    return ans;",
            "}",
            "",
            "const int MAX = 300005;",
            "ll fact[MAX], invFact[MAX];",
            "",
            "ll modInverse(ll n) {",
            "    return mypow(n, mod - 2, mod);",
            "}",
            "",
            "void init() {",
            "    fact[0] = 1;",
            "    invFact[0] = 1;",
            "    for (int i = 1; i < MAX; i++) {",
            "        fact[i] = (fact[i - 1] * i) % mod;",
            "    }",
            "    invFact[MAX - 1] = modInverse(fact[MAX - 1]);",
            "    for (int i = MAX - 2; i >= 1; i--) {",
            "        invFact[i] = (invFact[i + 1] * (i + 1)) % mod;",
            "    }",
            "}",
            "",
            "ll nCr(int n, int r) {",
            "    if (r < 0 || r > n) return 0;",
            "    return fact[n] * invFact[r] % mod * invFact[n - r] % mod;",
            "}",
            "$0"
        ],
        "description": "組み合わせ (nCr) ・階乗・逆元ライブラリ (init要呼び出し)"
    },

    "Union_Find": {
        "prefix": "uf",
        "body": [
            "// Union-Find (Disjoint Set Union)",
            "class UnionFind {",
            "private:",
            "    vector<int> parent, siz;",
            "public:",
            "    void init(int n) {",
            "        parent.assign(n + 1, -1);",
            "        siz.assign(n + 1, 1);",
            "    }",
            "    int root(int x) {",
            "        if (parent[x] == -1) return x;",
            "        return parent[x] = root(parent[x]);",
            "    }",
            "",
            "    bool issame(int x, int y) {",
            "        return root(x) == root(y);",
            "    }",
            "",
            "    bool unite(int x, int y) {",
            "        x = root(x); y = root(y);",
            "        if (x == y) return false;",
            "        if (siz[x] < siz[y]) swap(x, y);",
            "        parent[y] = x;",
            "        siz[x] += siz[y];",
            "        return true;",
            "    }",
            "",
            "    int size(int x) {",
            "        return siz[root(x)];",
            "    }",
            "};",
            "$0"
        ],
        "description": "Union-Find木 (init付き / 経路圧縮 + サイズ最適化)"
    },

